#!/usr/bin/env bash

set -euo pipefail

TAB_LABEL="feature-map-audit"
THINKING_LEVEL="xhigh"
START_TIMEOUT_SECONDS=10

PROMPT=$'/skill:feature-map-audit\n\nAudit the current branch changes against the Depiqo Feature Map.'

# ── Preconditions ─────────────────────────────────────────────────────────────

command -v herdr >/dev/null 2>&1 || {
  echo "Feature Map audit: herdr is not available." >&2
  exit 1
}

command -v jq >/dev/null 2>&1 || {
  echo "Feature Map audit: jq is not available." >&2
  exit 1
}

if [[ "${HERDR_ENV:-}" != "1" || -z "${HERDR_PANE_ID:-}" ]]; then
  echo "Feature Map audit: not running inside Herdr." >&2
  exit 1
fi

if [[ -z "${HERDR_SESSION:-}" ]]; then
  echo "Feature Map audit: HERDR_SESSION is not available." >&2
  exit 1
fi

if [[ -z "${FEATURE_MAP_AUDIT_MODEL:-}" ]]; then
  echo "Feature Map audit: FEATURE_MAP_AUDIT_MODEL is not set." >&2
  exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
SHORT_SHA="$(git rev-parse --short HEAD)"

SKILL_PATH="$REPO_ROOT/.pi/skills/feature-map-audit/SKILL.md"

if [[ ! -f "$SKILL_PATH" ]]; then
  echo "Feature Map audit: skill not found at $SKILL_PATH." >&2
  exit 1
fi

AGENT_NAME="fmap-${SHORT_SHA}-$$"

# ── Resolve current Herdr workspace ───────────────────────────────────────────

if ! PANE="$(
  herdr pane get "$HERDR_PANE_ID" \
    --session "$HERDR_SESSION" \
    2>&1
)"; then
  echo "Feature Map audit: failed to resolve current Herdr pane." >&2
  echo "$PANE" >&2
  exit 1
fi

WORKSPACE_ID="$(
  jq -r '.result.pane.workspace_id // empty' <<<"$PANE"
)"

if [[ -z "$WORKSPACE_ID" ]]; then
  echo "Feature Map audit: could not resolve current Herdr workspace." >&2
  exit 1
fi

# ── Create audit tab ──────────────────────────────────────────────────────────

if ! CREATED="$(
  herdr tab create \
    --workspace "$WORKSPACE_ID" \
    --cwd "$REPO_ROOT" \
    --label "$TAB_LABEL" \
    --no-focus \
    --session "$HERDR_SESSION" \
    2>&1
)"; then
  echo "Feature Map audit: failed to create Herdr tab." >&2
  echo "$CREATED" >&2
  exit 1
fi

TAB_ID="$(jq -r '.result.tab.tab_id // empty' <<<"$CREATED")"
PANE_ID="$(jq -r '.result.root_pane.pane_id // empty' <<<"$CREATED")"

if [[ -z "$TAB_ID" || -z "$PANE_ID" ]]; then
  echo "Feature Map audit: Herdr did not return the new tab/pane IDs." >&2
  exit 1
fi

# ── Start fresh Pi agent ──────────────────────────────────────────────────────
#
# A newly-created pane can briefly report agent_pane_busy while its shell is
# becoming interactive. Retry only that transient condition.

DEADLINE=$((SECONDS + START_TIMEOUT_SECONDS))

while true; do
  START_OUTPUT="$(mktemp)"

  if herdr agent start "$AGENT_NAME" \
    --kind pi \
    --pane "$PANE_ID" \
    --timeout 30000 \
    --session "$HERDR_SESSION" \
    -- \
    --model "$FEATURE_MAP_AUDIT_MODEL" \
    --thinking "$THINKING_LEVEL" \
    --tools read,bash,grep,find,ls \
    --skill "$SKILL_PATH" \
    >"$START_OUTPUT" 2>&1
  then
    rm -f "$START_OUTPUT"
    break
  fi

  ERROR_CODE="$(
    jq -r '.error.code // empty' "$START_OUTPUT" 2>/dev/null || true
  )"

  if [[ "$ERROR_CODE" != "agent_pane_busy" || "$SECONDS" -ge "$DEADLINE" ]]; then
    echo "Feature Map audit: failed to start Pi agent." >&2
    cat "$START_OUTPUT" >&2
    rm -f "$START_OUTPUT"
    exit 1
  fi

  rm -f "$START_OUTPUT"

  # Backoff only. Herdr remains the authority on whether the pane is ready.
  sleep 0.1
done

# ── Submit audit ──────────────────────────────────────────────────────────────

PROMPT_OUTPUT="$(mktemp)"

if ! herdr agent prompt "$AGENT_NAME" "$PROMPT" \
  --session "$HERDR_SESSION" \
  >"$PROMPT_OUTPUT" 2>&1
then
  echo "Feature Map audit: failed to submit audit prompt." >&2
  cat "$PROMPT_OUTPUT" >&2
  rm -f "$PROMPT_OUTPUT"
  exit 1
fi

rm -f "$PROMPT_OUTPUT"

printf '\n✓ Feature Map audit started\n\n'
