enum V2UserRole {
  USER
  ADMIN
}

enum V2UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum V2AuthProvider {
  LOCAL
  GOOGLE
}

enum V2PasswordAlgorithm {
  ARGON2ID
  BCRYPT
}

enum V2AuthAuditEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  LOGOUT_ALL_DEVICES
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  GOOGLE_LINKED
  GOOGLE_UNLINKED
  ACCOUNT_CREATED
  SESSION_INVALIDATED
}

model V2TenantUser {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  email           String    @unique
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  name            String?
  avatarUrl       String?   @map("avatar_url")

  role   V2UserRole   @default(USER)
  status V2UserStatus @default(ACTIVE)

  sessionVersion    Int       @default(1) @map("session_version")
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(3)

  tenant              V2Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  identities          V2AuthIdentity[]
  localCredential     V2LocalCredential?
  passwordResetTokens V2PasswordResetToken[]
  auditEvents         V2AuthAuditEvent[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status])
  @@index([role])
  @@index([createdAt])
  @@map("v2_tenant_users")
}

model V2AuthIdentity {
  id String @id @default(cuid())

  userId String       @map("user_id")
  user   V2TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          V2AuthProvider
  providerAccountId String         @map("provider_account_id")

  email         String?
  emailVerified Boolean @default(false) @map("email_verified")

  profile Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
  @@index([email])
  @@map("v2_auth_identities")
}

model V2LocalCredential {
  id String @id @default(cuid())

  userId String       @unique @map("user_id")
  user   V2TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  passwordHash      String              @unique @map("password_hash")
  passwordAlgorithm V2PasswordAlgorithm @default(ARGON2ID) @map("password_algorithm")
  passwordUpdatedAt DateTime            @default(now()) @map("password_updated_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("v2_local_credentials")
}

model V2PasswordResetToken {
  id String @id @default(cuid())

  userId String       @map("user_id")
  user   V2TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  requestIp String? @map("request_ip")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("v2_password_reset_tokens")
}

model V2AuthAuditEvent {
  id String @id @default(cuid())

  userId String?       @map("user_id")
  user   V2TenantUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  type V2AuthAuditEventType

  ip        String?
  userAgent String? @map("user_agent")
  metadata  Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("v2_auth_audit_events")
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json
  expire DateTime @db.Timestamptz(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
  @@ignore
}
