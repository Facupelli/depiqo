// ---------------------------------------------------------------------------
// V2 TENANT MANAGEMENT - BRANCHES
// ---------------------------------------------------------------------------

enum V2BranchScheduleSlotType {
  PICKUP
  RETURN
}

model V2Branch {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  name     String
  address  String?
  timezone String?

  operationalLocationFormattedAddress String? @map("operational_location_formatted_address")
  operationalLocationLatitude         Float?  @map("operational_location_latitude")
  operationalLocationLongitude        Float?  @map("operational_location_longitude")
  operationalLocationStreet           String? @map("operational_location_street")
  operationalLocationStreetNumber     String? @map("operational_location_street_number")
  operationalLocationCity             String? @map("operational_location_city")
  operationalLocationStateRegion      String? @map("operational_location_state_region")
  operationalLocationPostalCode       String? @map("operational_location_postal_code")
  operationalLocationCountry          String? @map("operational_location_country")
  operationalLocationProviderPlaceId  String? @map("operational_location_provider_place_id")
  isActive Boolean @default(true) @map("is_active")

  supportsDelivery           Boolean @default(false) @map("supports_delivery")
  deliveryDefaultCountry     String? @map("delivery_default_country")
  deliveryDefaultStateRegion String? @map("delivery_default_state_region")
  deliveryDefaultCity        String? @map("delivery_default_city")
  deliveryDefaultPostalCode  String? @map("delivery_default_postal_code")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant    V2Tenant           @relation(fields: [tenantId], references: [id])
  schedules V2BranchSchedule[]

  @@index([tenantId, isActive, deletedAt])
  @@map("v2_branches")
}

model V2BranchSchedule {
  id       String                   @id @default(uuid())
  branchId String                   @map("branch_id")
  type     V2BranchScheduleSlotType

  dayOfWeek    Int?      @map("day_of_week")
  specificDate DateTime? @map("specific_date") @db.Date

  openTime            Int  @map("open_time")
  closeTime           Int  @map("close_time")
  slotIntervalMinutes Int? @map("slot_interval_minutes")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch V2Branch @relation(fields: [branchId], references: [id])

  @@index([branchId, type])
  @@map("v2_branch_schedules")
}
