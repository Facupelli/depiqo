// ---------------------------------------------------------------------------
// V2 TENANT MANAGEMENT - TENANTS
// ---------------------------------------------------------------------------

enum V2TenantStatus {
  ACTIVE
  DISABLED
}

enum V2TenantDomainStatus {
  PENDING
  VERIFIED
  DISABLED
}

model V2Tenant {
  id     String         @id @default(uuid())
  name   String
  slug   String         @unique
  status V2TenantStatus @default(ACTIVE)
  config Json           @default("{}")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  branding        V2TenantBranding?
  contractSigners V2TenantContractSigner[]
  tenantUsers     V2TenantUser[]
  branches        V2Branch[]
  rentalCustomers V2RentalCustomer[]
  domains         V2TenantDomain[]

  @@index([status, deletedAt])
  @@map("v2_tenants")
}

model V2TenantBranding {
  id       String @id @default(uuid())
  tenantId String @unique @map("tenant_id")

  logoUrl    String? @map("logo_url")
  faviconUrl String? @map("favicon_url")

  primaryColor   String? @map("primary_color")
  accentColor    String? @map("accent_color")
  storefrontName String? @map("storefront_name")
  tagline        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant V2Tenant @relation(fields: [tenantId], references: [id])

  @@map("v2_tenant_branding")
}

model V2TenantDomain {
  id         String               @id @default(uuid())
  tenantId   String               @map("tenant_id")

  domain     String
  status     V2TenantDomainStatus @default(PENDING)
  isPrimary  Boolean              @default(false) @map("is_primary")

  cfHostnameId String? @map("cf_hostname_id")

  verifiedAt    DateTime? @map("verified_at")
  lastCheckedAt DateTime? @map("last_checked_at")
  failureReason String?   @map("failure_reason")

  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")
  deletedAt  DateTime?            @map("deleted_at")

  tenant V2Tenant @relation(fields: [tenantId], references: [id])

  @@unique([domain])
  @@unique([cfHostnameId])
  @@index([tenantId, status, deletedAt])
  @@map("v2_tenant_domains")
}

model V2TenantContractSigner {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  fullName       String @map("full_name")
  documentNumber String @map("document_number")
  phone          String?
  address        String?

  signatureUrl String? @map("signature_url")

  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant V2Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, isActive, deletedAt])
  @@map("v2_tenant_contract_signers")
}
