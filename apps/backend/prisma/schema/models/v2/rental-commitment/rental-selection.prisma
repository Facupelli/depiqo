// ---------------------------------------------------------------------------
// V2 RENTAL COMMITMENT - RENTAL SELECTIONS
// ---------------------------------------------------------------------------

model V2RentalSelection {
  id                       String             @id @default(uuid())
  tenantId                 String             @map("tenant_id")
  rentalId                 String             @map("rental_id")
  rentalOfferId            String             @map("rental_offer_id")
  rentableItemId           String             @map("rentable_item_id")
  rentableItemNameSnapshot String             @map("rentable_item_name_snapshot")
  rentableItemKindSnapshot V2RentableItemKind @map("rentable_item_kind_snapshot")
  quantity                 Int
  priceSnapshot            Json?              @map("price_snapshot")
  createdAt                DateTime           @default(now()) @map("created_at")

  rental      V2Rental             @relation(fields: [rentalId], references: [id])
  demandLines V2RentalDemandLine[]

  @@index([tenantId, rentalId])
  @@index([rentalOfferId])
  @@index([rentableItemId])
  @@map("v2_rental_selections")
}

model V2RentalAccessorySelection {
  id                        String   @id @default(uuid())
  tenantId                  String   @map("tenant_id")
  rentalOrderId             String   @map("rental_order_id")
  sourceRentalDemandLineId  String?  @map("source_rental_demand_line_id")

  equipmentTypeId           String   @map("equipment_type_id")
  equipmentTypeNameSnapshot String   @map("equipment_type_name_snapshot")
  quantity                  Int

  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  rental                 V2Rental            @relation(fields: [rentalOrderId], references: [id])

  assignments V2RentalAccessoryAssetAssignment[]
  demandLines V2RentalDemandLine[]

  @@index([tenantId, rentalOrderId])
  @@index([sourceRentalDemandLineId])
  @@index([equipmentTypeId])
  @@map("rental_accessory_selections")
}
