// ---------------------------------------------------------------------------
// V2 RENTAL COMMITMENT - ASSIGNED ASSET REFERENCES
// ---------------------------------------------------------------------------

model V2AssignedAsset {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  rentalId           String   @map("rental_id")
  rentalDemandLineId String   @map("rental_demand_line_id")
  assetId            String   @map("asset_id")
  createdAt          DateTime @default(now()) @map("created_at")

  rental           V2Rental           @relation(fields: [rentalId], references: [id])
  rentalDemandLine V2RentalDemandLine @relation(fields: [rentalDemandLineId], references: [id])

  @@unique([rentalDemandLineId, assetId])
  @@index([tenantId, rentalId])
  @@index([assetId])
  @@map("v2_assigned_assets")
}

model V2RentalAccessoryAssetAssignment {
  id                         String   @id @default(uuid())
  tenantId                   String   @map("tenant_id")
  rentalOrderId              String   @map("rental_order_id")
  rentalAccessorySelectionId String   @map("rental_accessory_selection_id")
  assetId                    String   @map("asset_id")
  
  createdAt                  DateTime @default(now()) @map("created_at")

  rental                   V2Rental                   @relation(fields: [rentalOrderId], references: [id])
  rentalAccessorySelection V2RentalAccessorySelection @relation(fields: [rentalAccessorySelectionId], references: [id])

  @@unique([rentalAccessorySelectionId, assetId])
  @@index([tenantId, rentalOrderId])
  @@index([assetId])
  @@map("rental_accessory_asset_assignments")
}
