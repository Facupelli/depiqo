model V2Coupon {
  id                     String    @id @default(uuid())
  tenantId               String    @map("tenant_id")
  promotionId            String    @map("promotion_id")
  code                   String
  maxUses                Int?      @map("max_uses")
  maxUsesPerCustomer     Int?      @map("max_uses_per_customer")
  restrictedToCustomerId String?   @map("restricted_to_customer_id")
  validFrom              DateTime? @map("valid_from")
  validUntil             DateTime? @map("valid_until")
  isActive               Boolean   @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  promotion   V2Promotion          @relation(fields: [promotionId], references: [id])
  redemptions V2CouponRedemption[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@index([promotionId])
  @@index([restrictedToCustomerId])
  @@map("v2_coupons")
}

model V2CouponRedemption {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  couponId   String    @map("coupon_id")
  orderId    String    @unique @map("order_id")
  customerId String?   @map("customer_id")
  redeemedAt DateTime  @default(now()) @map("redeemed_at")
  voidedAt   DateTime? @map("voided_at")

  coupon V2Coupon @relation(fields: [couponId], references: [id])

  @@unique([couponId, orderId])
  @@index([tenantId, couponId, voidedAt])
  @@index([couponId, voidedAt])
  @@index([couponId, customerId, voidedAt])
  @@index([orderId])
  @@map("v2_coupon_redemptions")
}
