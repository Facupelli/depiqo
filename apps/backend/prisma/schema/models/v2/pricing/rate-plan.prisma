enum V2BillingUnit {
  HOUR
  DAY
  WEEK
}

model V2RatePlan {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  name        String
  billingUnit V2BillingUnit @map("billing_unit")
  currency    String
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(3)

  tiers               V2RatePlanTier[]
  rentalOfferPricings V2RentalOfferPricing[]

  @@index([tenantId, isActive])
  @@map("v2_rate_plans")
}

model V2RatePlanTier {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  ratePlanId   String   @map("rate_plan_id")
  fromUnit     Int      @map("from_unit")
  toUnit       Int?     @map("to_unit")
  pricePerUnit Decimal  @map("price_per_unit")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  ratePlan V2RatePlan @relation(fields: [ratePlanId], references: [id])

  @@unique([ratePlanId, fromUnit])
  @@index([tenantId])
  @@index([ratePlanId])
  @@map("v2_rate_plan_tiers")
}
