// ---------------------------------------------------------------------------
// V2 RENTAL CATALOG - RENTABLE ITEMS, OFFERS, AND FULFILLMENT REQUIREMENTS
// ---------------------------------------------------------------------------

enum V2RentableItemKind {
  SINGLE
  PACKAGE
  KIT
  BUNDLE
}

model V2RentableItem {
  id          String               @id @default(uuid())
  tenantId    String               @map("tenant_id")
  name        String
  description String?
  imageUrl    String?              @map("image_url")
  categoryId  String?              @map("category_id")
  kind        V2RentableItemKind
  archivedAt  DateTime?            @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  category     V2Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  rentalOffers V2RentalOffer[]
  requirements V2RentableItemRequirement[]

  @@index([tenantId, archivedAt, categoryId])
  @@map("v2_rentable_items")
}

model V2RentalOffer {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  branchId         String    @map("branch_id")
  rentableItemId   String    @map("rentable_item_id")
  showInStore      Boolean   @default(false) @map("show_in_store")
  isRentable       Boolean   @default(false) @map("is_rentable")
  firstPublishedAt DateTime? @map("first_published_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  rentableItem V2RentableItem @relation(fields: [rentableItemId], references: [id])

  @@unique([tenantId, branchId, rentableItemId], map: "v2_rental_offers_tenant_branch_item_key")
  @@index([tenantId, branchId, showInStore, firstPublishedAt], map: "v2_rental_offers_tenant_branch_store_published_idx")
  @@index([tenantId, branchId, isRentable], map: "v2_rental_offers_tenant_branch_rentable_idx")
  @@index([rentableItemId])
  @@map("v2_rental_offers")
}

model V2RentableItemRequirement {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  rentableItemId  String   @map("rentable_item_id")
  equipmentTypeId String   @map("equipment_type_id")
  quantityPerItem Int      @map("quantity_per_item")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  rentableItem V2RentableItem @relation(fields: [rentableItemId], references: [id])

  @@unique([rentableItemId, equipmentTypeId])
  @@index([tenantId, rentableItemId])
  @@map("v2_fulfillment_requirements")
}
