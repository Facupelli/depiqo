enum V2NotificationChannel {
  EMAIL
  // Later:
  // SMS
  // WHATSAPP
}

enum V2NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model V2NotificationTemplate {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  key     String
  channel V2NotificationChannel
  locale  String                @default("es")
  version Int                   @default(1)

  subjectTemplate String? @map("subject_template")
  bodyTemplate    String  @map("body_template")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  notifications V2Notification[]

  @@unique([tenantId, key, channel, locale, version])
  @@index([tenantId, key, channel, isActive])
  @@map("v2_notification_templates")
}

model V2Notification {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  type String

  templateId      String? @map("template_id")
  templateKey     String? @map("template_key")
  templateVersion Int?    @map("template_version")

  subject String?
  body    String

  sourceContext       String? @map("source_context")
  sourceEventId       String? @map("source_event_id")
  sourceAggregateType String? @map("source_aggregate_type")
  sourceAggregateId   String? @map("source_aggregate_id")

  idempotencyKey String? @map("idempotency_key")

  metadata    Json    @default("{}")
  contentHash String? @map("content_hash")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  template   V2NotificationTemplate?  @relation(fields: [templateId], references: [id])
  deliveries V2NotificationDelivery[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([tenantId, sourceAggregateId])
  @@map("v2_notifications")
}

model V2NotificationDelivery {
  id             String @id @default(cuid())
  tenantId       String @map("tenant_id")
  notificationId String @map("notification_id")

  channel   V2NotificationChannel
  recipient String

  status V2NotificationDeliveryStatus @default(PENDING)

  attemptCount Int @default(0) @map("attempt_count")

  provider          String?
  providerMessageId String? @map("provider_message_id")
  providerResult    Json?   @map("provider_result")

  lastErrorCode    String? @map("last_error_code")
  lastErrorMessage String? @map("last_error_message")

  lastAttemptAt DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(3)
  failedAt      DateTime? @map("failed_at") @db.Timestamptz(3)
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  notification V2Notification @relation(fields: [notificationId], references: [id], onDelete: Restrict)

  @@unique([notificationId, channel, recipient])
  @@index([tenantId, status])
  @@index([notificationId])
  @@map("v2_notification_deliveries")
}
