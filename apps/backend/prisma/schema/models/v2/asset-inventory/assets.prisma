// ---------------------------------------------------------------------------
// V2 ASSET INVENTORY - ASSETS
// ---------------------------------------------------------------------------

enum V2AssetStatus {
  ACTIVE
  INACTIVE
  RETIRED
}

model V2Asset {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  branchId        String        @map("branch_id")
  equipmentTypeId String        @map("equipment_type_id")
  ownerId         String?       @map("owner_id")
  serialNumber    String?       @map("serial_number")
  notes           String?
  status          V2AssetStatus @default(ACTIVE)
  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  equipmentType  V2EquipmentType   @relation(fields: [equipmentTypeId], references: [id])
  owner          V2AssetOwner?     @relation(fields: [ownerId], references: [id])
  ownerContracts V2OwnerContract[]

  @@index([tenantId, branchId, equipmentTypeId, status, deletedAt])
  @@index([tenantId, equipmentTypeId, branchId, status, deletedAt])
  @@map("v2_assets")
}
