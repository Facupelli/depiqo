// ---------------------------------------------------------------------------
// V2 ASSET INVENTORY - EQUIPMENT TYPES
// ---------------------------------------------------------------------------

model V2EquipmentType {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  accessoryDefaults V2EquipmentTypeAccessoryDefault[] @relation("AccessoryDefaultsForEquipment")
  usedAsAccessoryIn V2EquipmentTypeAccessoryDefault[] @relation("EquipmentUsedAsAccessory")
  assets            V2Asset[]

  @@index([tenantId, isActive, deletedAt])
  @@map("v2_equipment_types")
}

// TODO: add manual DB checks for positive quantities and no self-reference
model V2EquipmentTypeAccessoryDefault {
  id                       String   @id @default(uuid())
  tenantId                 String   @map("tenant_id")
  equipmentTypeId          String   @map("equipment_type_id")
  accessoryEquipmentTypeId String   @map("accessory_equipment_type_id")
  quantity                 Int
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  equipmentType          V2EquipmentType @relation("AccessoryDefaultsForEquipment", fields: [equipmentTypeId], references: [id])
  accessoryEquipmentType V2EquipmentType @relation("EquipmentUsedAsAccessory", fields: [accessoryEquipmentTypeId], references: [id])

  @@unique([tenantId, equipmentTypeId, accessoryEquipmentTypeId])
  @@index([tenantId])
  @@index([equipmentTypeId])
  @@index([accessoryEquipmentTypeId])
  @@map("equipment_type_accessory_defaults")
}
