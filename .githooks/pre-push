#!/usr/bin/env bash

set -u

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
AUDIT_SCRIPT="$REPO_ROOT/bin/feature-map-audit"

if [[ ! -f "$AUDIT_SCRIPT" ]]; then
  echo "pre-push: Feature Map audit launcher not found; continuing push." >&2
  exit 0
fi

if [[ "${HERDR_ENV:-}" != "1" || -z "${HERDR_PANE_ID:-}" ]]; then
  echo "pre-push: not running inside Herdr; skipping Feature Map audit." >&2
  exit 0
fi

echo "pre-push: starting Feature Map audit..."

if ! bash "$AUDIT_SCRIPT"; then
  echo "pre-push: Feature Map audit failed to start; continuing push." >&2
fi

exit 0
